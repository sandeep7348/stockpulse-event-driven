# Optional. The default feed is yahoo, which needs no settings at all.
# Copy to .env, which git ignores, and never commit real values.

# Random prices that keep moving when the market is closed, useful for demos:
# FEED_SOURCE=simulated

# Live Upstox prices, which need an Upstox account:
# FEED_SOURCE=upstox
# UPSTOX_ACCESS_TOKEN=paste-your-token-here
